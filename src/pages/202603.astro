---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.pageTitle}</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <main>
      <h1>{meta.title} <br> {meta.subtitle}</h1>

      <!-- VISITED SECTION -->
      {visited && (
        <section class="visited">
          <div class="visited-text">
            <span class="label">{visited.label}</span>
            <h2>{visited.city}</h2>
            <p>{visited.description1}</p>
            <p>{visited.description2}</p>
          </div>
        </section>
      )}

      <!-- POST (optional) -->
      {visited?.hasPost && (
        <div class="post">
          <button class="abstract-toggle" id="abstractToggle">expand ramblings +</button>
          <article class="post-content abstract-content" id="abstractContent">
            {visited.postBlocks.map((block) => (
              <>
                {block.type === "paragraph" && <p>{block.text}</p>}

                {block.type === "image" && (
                  <figure>
                    <img src={block.src} alt={block.alt} />
                    {block.caption && <figcaption>{block.caption}</figcaption>}
                  </figure>
                )}

              </>
            ))}
          </article>
        </div>
      )}

      <!-- COOL THINGS SECTION -->
      {coolThings && (
        <section class="cool-things-section">
          <span class="label">{coolThings.label}</span>
          <p>{coolThings.title}</p>
          <div class="cool-things-row">
            {coolThings.items.map((item) => (
              <figure class="cool-thing">
                <img src={item.image} alt={item.alt} />
                <figcaption>{item.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <!-- CONSUMED SECTION -->
      <section class="consumed-section">
        <span class="label">consumed</span>
        <p>A whole section to enjoy visual consumption with Sony RX100VII.</p>
        <div class="consumed-grid">
          {visibleConsumed.map((item) => (
            <div class="consumed-item">
              <img
                src={item.image}
                alt={item.alt}
                class="consumed-img"
                data-cursor={item.cursor}
              />
            </div>
          ))}
        </div>
        {hiddenConsumed.length > 0 && (
          <details class="  consumed-more">
            <summary>
              <span class="summary-base">see more?</span>
              <span class="summary-expanded" aria-hidden="true">hide me</span>
            </summary>
            <div class="consumed-grid consumed-grid-more">
              {hiddenConsumed.map((item) => (
                <div class="consumed-item">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="consumed-img"
                    data-cursor={item.cursor}
                  />
                </div>
              ))}
            </div>
          </details>
        )}
      </section>
    </main>

    <div class="cursor" id="cursor">
      <span class="cursor-text" id="cursor-text"></span>
    </div>

    <script>
      const cursor = document.getElementById('cursor');
      const cursorText = document.getElementById('cursor-text');

      document.addEventListener('mousemove', (e) => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
      });

      const hoverElements = document.querySelectorAll('[data-cursor]');
      hoverElements.forEach((el) => {
        el.addEventListener('mouseenter', () => {
          cursorText.textContent = el.getAttribute('data-cursor');
          cursor.classList.add('expanded');
        });
        el.addEventListener('mouseleave', () => {
          cursor.classList.remove('expanded');
          cursorText.textContent = '';
        });
      });

      const toggle = document.getElementById('abstractToggle');
      const content = document.getElementById('abstractContent');
      if (toggle && content) {
        toggle.addEventListener('click', () => {
          content.classList.toggle('open');
          toggle.textContent = content.classList.contains('open') ? 'close -' : 'read more +';
        });
      }

      const moreDetails = document.querySelector('.consumed-more');
      if (moreDetails) {
        const syncMoreLabel = () => {
          moreDetails.dataset.open = moreDetails.open ? 'true' : 'false';
        };
        syncMoreLabel();
        moreDetails.addEventListener('toggle', syncMoreLabel);
      }
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Bianzhidai';
    src: url('/font_bianzhidai/bianzhidai_COLR-GRAY.otf') format('opentype');
  }

  /* ---- CURSOR ---- */
  * { cursor: none; }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    background: black;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: width 0.1s ease, height 0.5s ease, border-radius 0.5s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 9999;
  }

  .cursor.expanded {
    width: auto;
    min-width: 200px;
    max-width: 300px;
    height: auto;
    min-height: 44px;
    padding: 0;
    border-radius: 22px;
  }
  .cursor-text {
    color: white;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    text-align: center;
    padding: 0.8rem 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease 0.1s;
    white-space: normal;
    line-height: 1.4;
  }

  .cursor.expanded .cursor-text { opacity: 1; }

  /* ---- POST ---- */
  .abstract-toggle {
    background: none;
    border: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: #888;
    cursor: none;
    padding: 0;
    display: block;
  }

  .abstract-toggle:hover { color: #1a1a1a; }

  .abstract-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease;
    font-size: 1rem;
    line-height: 1.7;
  }

  .abstract-content.open { max-height: 10000px; }

  .post-content {
    max-width: 70ch;
  }

  .post-content p {
    margin: 1rem 0;
  }

  .post-content figure {
    margin: 1.5rem 0;
  }

  .post-content img {
    width: 70%;
    max-width: 70%;
    height: auto;
    display: block;
  }

  .post-content figcaption {
    margin-top: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: #777;
  }

  .post {
    width: 100%;
    margin-bottom: 2rem;
    margin-top: -3rem;
  }

  /* ---- COOL THINGS ---- */
  .cool-things-section {
    margin: 2.5rem 0 4rem;
    width: 100%;
  }

  .cool-things-section > p {
    margin: 0 0 1rem;
  }

  .cool-things-row {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .cool-thing {
    flex: 0 0 clamp(150px, 22vw, 240px);
    margin: 0;
  }

  .cool-thing img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .cool-thing figcaption {
    margin-top: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #1a1a1a;
  }

  /* ---- BASE ---- */
  body {
    font-family: 'Space Grotesk', 'Noto Sans TC', sans-serif;
    background-color: #f5f0eb;
    color: #1a1a1a;
    margin: 0;
    padding: 2rem 3rem;
  }

  h1 {
    font-family: 'Bianzhidai', monospace;
    font-size: 3rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 3rem;
  }

  h2 {
    font-family: 'Bianzhidai', monospace;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-top: -0.5rem;
    margin-bottom: 0.5rem;
  }

  .label {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.75rem;
  }

  /* ---- VISITED ---- */
  .visited {
    display: flex;
    gap: 2rem;
    margin-bottom: 4rem;
    align-items: flex-start;
  }

  .visited-text { flex: 2; }

  .visited-text p {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    margin-bottom: 0.75rem;
  }

  .visited-image { flex: 1.5; }

  .visited-image img {
    width: 100%;
    display: block;
  }

  /* ---- CONSUMED SECTION ---- */
  .consumed-section {
    padding-top: 2rem;
    width: 100%;
  }

  .consumed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .consumed-more {
    margin-top: 1.25rem;
  }

  .consumed-more summary {
    display: inline-flex;
    align-items: center;
    position: relative;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 0.1rem;
    list-style: none;
    overflow: hidden;
    white-space: nowrap;
  }

  .consumed-more summary::-webkit-details-marker {
    display: none;
  }

  .consumed-more summary:hover {
    color: #888;
    border-bottom-color: #888;
  }

  .summary-base,
  .summary-expanded {
    display: inline-block;
    transition: transform 0.38s cubic-bezier(0.2, 1, 0.3, 1), opacity 0.28s ease, max-width 0.38s cubic-bezier(0.2, 1, 0.3, 1);
    transform-origin: left center;
  }

  .summary-base {
    max-width: 10rem;
    opacity: 1;
    transform: scaleX(1);
  }

  .summary-expanded {
    max-width: 0;
    opacity: 0;
    transform: scaleX(0.7);
    margin-left: 0;
  }

  .consumed-more[open] .summary-base {
    max-width: 0;
    opacity: 0;
    transform: scaleX(0.7);
  }

  .consumed-more[open] .summary-expanded {
    max-width: 16rem;
    opacity: 1;
    transform: scaleX(1);
    margin-left: 0.35rem;
  }

  .consumed-grid-more {
    margin-top: 1rem;
  }

  /* MASONRY OPTION (Comment out the grid styles above and uncomment these to use)
  .consumed-grid {
    column-width: 150px;
    column-gap: 1rem;
    width: 100%;
  }
  .consumed-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    display: block;
  }
  .consumed-img {
    height: auto;
    aspect-ratio: auto;
  }
  */

  .consumed-item {
    width: 100%;
    overflow: hidden;
    border-radius: 4px;
  }

  .consumed-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .consumed-item:hover .consumed-img {
    transform: scale(1.1);
  }

  /* ---- LINKS ---- */
  .column a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.9rem;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 0.1rem;
  }

  .column a:hover {
    color: #888;
    border-bottom-color: #888;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 768px) {
    body { padding: 1.5rem; }

    .visited { flex-direction: column; }
    .visited-image { width: 100%; }

     .consumed-section { padding: 1.5rem 0; }
     .consumed-grid { grid-template-columns: repeat(2, 1fr); } /* 2 columns on mobile */
     /* .consumed-grid { column-count: 2; } */ /* Uncomment for masonry on mobile */

     .post-content img {
       width: 100%;
       max-width: 100%;
     }
  }
</style>
