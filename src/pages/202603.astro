---
// ============================================================
// EDIT THIS SECTION EACH MONTH — everything else stays the same
// ============================================================

const meta = {
  title: "2026 March",
  subtitle: "三月",
  pageTitle: "2026-03",
}

// VISITED SECTION
// Set to null if you have no visited section this month
const visited = {
  label: "visited",
  city: "Japan",
  description1: ",
  description2: "Your second paragraph, e.g. event title or details.",
  image: "/your-banner.jpg",
  imageAlt: "description of image",
  imageLink: "https://your-link.com",
  imageCursor: "Your cursor hover text here",
  hasAbstract: false,
  abstractText: "",
}

// CREATED SECTION
const created = {
  image: "/created.png",
  imageAlt: "created",
  imageCursor: "Your cursor hover text here",
}

// CONSUMED SECTION — two overlapping images
const consumed = {
  front: {
    image: "/consumed1.png",
    alt: "consumed 1",
    cursor: "Your description for consumed 1",
  },
  back: {
    image: "/consumed2.png",
    alt: "consumed 2",
    cursor: "Your description for consumed 2",
  },
}

// THINKING SECTION
const thinking = {
  linkText: "Your thinking piece title here",
  linkUrl: "https://your-link.com",
  linkCursor: "Read more",
}

// ============================================================
// NOTHING BELOW THIS LINE NEEDS TO BE EDITED EACH MONTH
// ============================================================
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.pageTitle}</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <main>
      <h1>{meta.title} <br> {meta.subtitle}</h1>

      <!-- VISITED SECTION -->
      {visited && (
        <section class="visited">
          <div class="visited-text">
            <span class="label">{visited.label}</span>
            <h2>{visited.city}</h2>
            <p>{visited.description1}</p>
            <p>{visited.description2}</p>
          </div>
          <div class="visited-image">
            <a href={visited.imageLink} target="_blank" data-cursor={visited.imageCursor}>
              <img src={visited.image} alt={visited.imageAlt} />
            </a>
          </div>
        </section>
      )}

      <!-- ABSTRACT (optional) -->
      {visited?.hasAbstract && (
        <div class="abstract">
          <button class="abstract-toggle" id="abstractToggle">read abstract +</button>
          <div class="abstract-content" id="abstractContent">
            <p>{visited.abstractText}</p>
          </div>
        </div>
      )}

      <!-- CREATED | CONSUMED | THINKING -->
      <section class="columns">
        <div class="column">
          <span class="label">created</span>
          <img
            src={created.image}
            alt={created.imageAlt}
            data-cursor={created.imageCursor}
            class="created-img"
          />
        </div>

        <div class="column">
          <span class="label">consumed</span>
          <div class="consumed-stack">
            <img
              src={consumed.back.image}
              alt={consumed.back.alt}
              class="consumed-img consumed-back"
              data-cursor={consumed.back.cursor}
            />
            <img
              src={consumed.front.image}
              alt={consumed.front.alt}
              class="consumed-img consumed-front"
              data-cursor={consumed.front.cursor}
            />
          </div>
        </div>

        <div class="column">
          <span class="label">thinking</span>
          <a href={thinking.linkUrl} target="_blank" data-cursor={thinking.linkCursor}>
            {thinking.linkText}
          </a>
        </div>
      </section>
    </main>

    <div class="cursor" id="cursor">
      <span class="cursor-text" id="cursor-text"></span>
    </div>

    <script>
      const cursor = document.getElementById('cursor');
      const cursorText = document.getElementById('cursor-text');

      document.addEventListener('mousemove', (e) => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
      });

      const hoverElements = document.querySelectorAll('[data-cursor]');
      hoverElements.forEach((el) => {
        el.addEventListener('mouseenter', () => {
          cursorText.textContent = el.getAttribute('data-cursor');
          cursor.classList.add('expanded');
        });
        el.addEventListener('mouseleave', () => {
          cursor.classList.remove('expanded');
          cursorText.textContent = '';
        });
      });

      const toggle = document.getElementById('abstractToggle');
      const content = document.getElementById('abstractContent');
      if (toggle && content) {
        toggle.addEventListener('click', () => {
          content.classList.toggle('open');
          toggle.textContent = content.classList.contains('open') ? 'close abstract -' : 'read abstract +';
        });
      }
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Bianzhidai';
    src: url('/font_bianzhidai/bianzhidai_COLR-GRAY.otf') format('opentype');
  }

  /* ---- CURSOR ---- */
  * { cursor: none; }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    background: black;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: width 0.1s ease, height 0.5s ease, border-radius 0.5s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 9999;
  }

  .cursor.expanded {
    width: 200px;
    height: 44px;
    border-radius: 44px;
  }

  .cursor-text {
    color: white;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    text-align: center;
    padding: 0 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease 0.1s;
    white-space: nowrap;
  }

  .cursor.expanded .cursor-text { opacity: 1; }

  /* ---- ABSTRACT ---- */
  .abstract-toggle {
    background: none;
    border: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: #888;
    cursor: none;
    padding: 0;
    display: block;
  }

  .abstract-toggle:hover { color: #1a1a1a; }

  .abstract-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease;
    font-size: 1rem;
    line-height: 1.7;
  }

  .abstract-content.open { max-height: 10000px; }

  .abstract {
    width: 100%;
    margin-bottom: 2rem;
    margin-top: -3rem;
  }

  /* ---- BASE ---- */
  body {
    font-family: 'Space Grotesk', 'Noto Sans TC', sans-serif;
    background-color: #f5f0eb;
    color: #1a1a1a;
    margin: 0;
    padding: 2rem 3rem;
  }

  h1 {
    font-family: 'Bianzhidai', monospace;
    font-size: 3rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 3rem;
  }

  h2 {
    font-family: 'Bianzhidai', monospace;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-top: -0.5rem;
    margin-bottom: 0.5rem;
  }

  .label {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.75rem;
  }

  /* ---- VISITED ---- */
  .visited {
    display: flex;
    gap: 2rem;
    margin-bottom: 4rem;
    align-items: flex-start;
  }

  .visited-text { flex: 2; }

  .visited-text p {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    margin-bottom: 0.75rem;
  }

  .visited-image { flex: 1.5; }

  .visited-image img {
    width: 100%;
    display: block;
  }

  /* ---- COLUMNS ---- */
  .columns {
    display: flex;
    gap: 0;
    padding-top: 2rem;
  }

  .column { flex: 1; }
  .column:first-child { padding-left: 0; }
  .column:last-child { padding-right: 0; border-right: none; }

  /* ---- CREATED ---- */
  .created-img {
    height: 400px;
    width: auto;
    max-width: 100%;
  }

  /* ---- CONSUMED ---- */
  .consumed-stack {
    position: relative;
    height: 300px;
  }

  .consumed-img {
    position: absolute;
    height: 400px;
    width: auto;
    max-width: 100%;
  }

  .consumed-back {
    top: 10px;
    left: 35%;
    z-index: 1;
  }

  .consumed-front {
    top: 10px;
    left: 0px;
    z-index: 2;
  }

  /* ---- LINKS ---- */
  .column a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.9rem;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 0.1rem;
  }

  .column a:hover {
    color: #888;
    border-bottom-color: #888;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 768px) {
    body { padding: 1.5rem; }

    .visited { flex-direction: column; }
    .visited-image { width: 100%; }

    .columns { flex-direction: column; }

    .column {
      border-right: none;
      border-bottom: 1px solid #ddd;
      padding: 1.5rem 0;
    }

    .column:last-child { border-bottom: none; }

    .consumed-stack {
      height: 250px;
      width: 100%;
    }

    .consumed-img { height: 220px; }
    .consumed-back { left: 40%; }
    .consumed-front { left: 0px; }

    .created-img { height: 220px; }
  }
</style>
